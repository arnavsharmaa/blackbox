# --- Backend (apps/api) ---
# SQLite database location. The default keeps local state in ./data/.
BLACKBOX_DATABASE_URL=sqlite:///./data/blackbox.db
# Comma-separated list of origins allowed to call the API.
BLACKBOX_CORS_ORIGINS=http://localhost:3000
# Bind host/port for uvicorn (used by Makefile / docker-compose).
BLACKBOX_API_HOST=0.0.0.0
BLACKBOX_API_PORT=8000

# --- Optional AI explanation layer ---
# If one of these is set, /api/incidents/{id}/analysis?ai=true can attach an
# AI-generated summary of the deterministic analysis. Never required.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Frontend (apps/web) ---
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional default "owner/repo" used to prefill GitHub issue URLs.
NEXT_PUBLIC_GITHUB_REPO=
