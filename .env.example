# --- Backend (apps/api) ---
# SQLite database location. The default keeps local state in ./data/.
BLACKBOX_DATABASE_URL=sqlite:///./data/blackbox.db
# Comma-separated list of origins allowed to call the API.
BLACKBOX_CORS_ORIGINS=http://localhost:3000
# Bind host/port for uvicorn (used by Makefile / docker-compose).
BLACKBOX_API_HOST=0.0.0.0
BLACKBOX_API_PORT=8000

# --- Optional AI explanation layer ---
# If one of these is set, /api/incidents/{id}/analysis?ai=true can attach an
# AI-generated summary of the deterministic analysis. Never required.
# Anthropic is preferred when both are present.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# BLACKBOX_AI_ANTHROPIC_MODEL=claude-opus-5
# BLACKBOX_AI_OPENAI_MODEL=gpt-4o

# --- Analysis rule thresholds (optional, per-facility tuning) ---
# Every rule condition's numeric threshold can be overridden; defaults shown.
# See apps/api/blackbox_api/analysis/thresholds.py for the full list.
# BLACKBOX_RULE_OBSTACLE_SAFETY_THRESHOLD_M=0.6
# BLACKBOX_RULE_ZERO_CMD_STREAK_MIN=5
# BLACKBOX_RULE_LOC_CONF_FAULT=0.5
# BLACKBOX_RULE_ANGULAR_FLIPS_MIN=8
# BLACKBOX_RULE_SENSOR_GAP_MIN_S=2.0
# Custom analysis rules (comma-separated module:function specs).
# BLACKBOX_EXTRA_RULES=acme_rules:battery_sag

# --- Frontend (apps/web) ---
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional default "owner/repo" used to prefill GitHub issue URLs.
NEXT_PUBLIC_GITHUB_REPO=
