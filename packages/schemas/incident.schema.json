{
  "$defs": {
    "AlternativeCause": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "category",
        "score",
        "reason"
      ],
      "title": "AlternativeCause",
      "type": "object"
    },
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "ai_explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional AI-generated summary of the deterministic analysis. Never used to determine the root cause.",
          "title": "Ai Explanation"
        },
        "alternative_causes": {
          "items": {
            "$ref": "#/$defs/AlternativeCause"
          },
          "title": "Alternative Causes",
          "type": "array"
        },
        "analyzed_at": {
          "format": "date-time",
          "title": "Analyzed At",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "failure_category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "recommended_actions": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Actions",
          "type": "array"
        },
        "rules_triggered": {
          "items": {
            "type": "string"
          },
          "title": "Rules Triggered",
          "type": "array"
        }
      },
      "required": [
        "incident_id",
        "engine_version",
        "failure_category",
        "confidence",
        "explanation",
        "recommended_actions",
        "evidence",
        "alternative_causes",
        "rules_triggered",
        "analyzed_at"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "task_started",
        "nav_goal_issued",
        "pose_updated",
        "velocity_command",
        "planner_state_changed",
        "obstacle_distance_updated",
        "recovery_started",
        "recovery_completed",
        "warning_raised",
        "error_raised",
        "task_timed_out",
        "task_failed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/TelemetryChannel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "t": {
          "description": "Anchor time (s since incident start)",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "t_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T End"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "summary",
        "t"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "persistent_obstacle",
        "localization_failure",
        "controller_oscillation",
        "sensor_dropout",
        "unknown"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "A complete incident as ingested into BlackBox.",
      "properties": {
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "environment": {
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/IncidentEvent"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "facility": {
          "minLength": 1,
          "title": "Facility",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "map_version": {
          "minLength": 1,
          "title": "Map Version",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "robot_id": {
          "minLength": 1,
          "title": "Robot Id",
          "type": "string"
        },
        "robot_model": {
          "minLength": 1,
          "title": "Robot Model",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "software_version": {
          "minLength": 1,
          "title": "Software Version",
          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "task_goal": {
          "minLength": 1,
          "title": "Task Goal",
          "type": "string"
        },
        "task_name": {
          "minLength": 1,
          "title": "Task Name",
          "type": "string"
        },
        "telemetry": {
          "items": {
            "$ref": "#/$defs/TelemetrySeries"
          },
          "title": "Telemetry",
          "type": "array"
        }
      },
      "required": [
        "id",
        "robot_id",
        "robot_model",
        "facility",
        "task_name",
        "task_goal",
        "start_time",
        "end_time",
        "outcome",
        "severity",
        "software_version",
        "map_version",
        "environment",
        "summary",
        "events"
      ],
      "title": "Incident",
      "type": "object"
    },
    "IncidentEvent": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence_tags": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Tags",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "info"
        },
        "subsystem": {
          "$ref": "#/$defs/Subsystem"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "event_type",
        "subsystem",
        "message"
      ],
      "title": "IncidentEvent",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "success",
        "failed",
        "timed_out",
        "aborted"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Subsystem": {
      "enum": [
        "task_manager",
        "navigation",
        "planner",
        "controller",
        "localization",
        "perception",
        "system"
      ],
      "title": "Subsystem",
      "type": "string"
    },
    "TelemetryChannel": {
      "enum": [
        "pos_x",
        "pos_y",
        "heading",
        "linear_velocity",
        "angular_velocity",
        "obstacle_distance",
        "goal_distance",
        "localization_confidence",
        "planner_state",
        "recovery_count",
        "battery_pct"
      ],
      "title": "TelemetryChannel",
      "type": "string"
    },
    "TelemetrySample": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "Seconds since incident start_time",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "t",
        "value"
      ],
      "title": "TelemetrySample",
      "type": "object"
    },
    "TelemetrySeries": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/TelemetryChannel"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/TelemetrySample"
          },
          "title": "Samples",
          "type": "array"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "samples"
      ],
      "title": "TelemetrySeries",
      "type": "object"
    }
  },
  "title": "BlackBox incident schema"
}
